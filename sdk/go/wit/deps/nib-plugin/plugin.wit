package nib:plugin@0.7.3;

interface types {
    /// A UTF-8 byte offset into a buffer.
    type offset = u64;

    /// `start..end` of a buffer.
    record range { start: offset, end: offset }

    /// `head` is where the cursor is, so it may be before `anchor`.
    record sel-range { anchor: offset, head: offset }

    record selection { ranges: list<sel-range>, primary: u32 }

    /// Replaces `start..end` of the buffer before the change with `text`.
    record edit { start: offset, end: offset, text: string }

    enum undo-mode {
        /// Start a new undo step.
        new-step,
        /// Add to the last undo step, e.g. while typing in insert mode.
        merge,
    }

    enum cursor-shape { block, bar, underline }

    /// Shift is never set for chars: 'Q' already says it is shifted.
    flags modifiers { ctrl, alt, shift, super }

    variant key-code {
        %char(char),
        enter,
        escape,
        tab,
        backspace,
        delete,
        insert,
        up,
        down,
        left,
        right,
        home,
        end,
        page-up,
        page-down,
        f(u8),
    }

    record key-event { code: key-code, modifiers: modifiers }

    /// `style` names a theme entry, e.g. "ui.mode.normal".
    record span { text: string, style: string }

    type styled-line = list<span>;

    variant error {
        /// The change was built against an older version of the buffer.
        stale-version,
        /// The offset is out of bounds or not on a char boundary.
        invalid-position,
        /// Edits in one change overlap each other.
        overlapping-edits,
        /// A selection needs at least one range and a primary index in bounds.
        invalid-selection,
        invalid-pattern(string),
        /// A plugin's buffer, which only its owner changes, with
        /// `buffer.apply`.
        read-only,
        other(string),
    }
}

interface buffer {
    use types.{offset, range, edit, undo-mode, error};

    resource buffer {
        /// Increases on every change, including undo and redo.
        version: func() -> u64;
        len: func() -> offset;
        slice: func(start: offset, end: offset) -> result<string, error>;
        /// Text ending with a line break has an empty last line.
        line-count: func() -> u64;
        line-start: func(line: u64) -> option<offset>;
        line-of: func(pos: offset) -> result<u64, error>;
        next-grapheme: func(pos: offset) -> result<offset, error>;
        prev-grapheme: func(pos: offset) -> result<offset, error>;
        path: func() -> option<string>;
        /// What it is called: its path as opened, the name the plugin that
        /// made it gave it, or "[scratch]".
        name: func() -> string;
        /// Changed since it was last saved or opened. Undoing back to that
        /// state makes it unchanged again.
        modified: func() -> bool;
        /// The first match starting at or after `start`, or with `backward`,
        /// the last match ending at or before `start`. `^` and `$` match at
        /// every line.
        find: func(pattern: string, start: offset, backward: bool) -> result<option<range>, error>;
        /// As `find`, with the pattern's groups: the whole match first, then
        /// each group, `none` for a group that took no part.
        find-groups: func(pattern: string, start: offset, backward: bool) -> result<option<list<option<range>>>, error>;
        find-all: func(pattern: string, start: offset, end: offset) -> result<list<range>, error>;
        /// Replaces the positions this plugin keeps in `namespace` of this
        /// buffer, such as vim's marks or Emacs's mark ring; an empty list
        /// removes them. The core moves them with every edit, whoever makes
        /// it: they stay before text inserted where they are, and go where
        /// deleted text was. Positions past the end go to the end.
        set-marks: func(namespace: string, marks: list<offset>);
        /// The positions this plugin keeps in `namespace`, in the order set.
        marks: func(namespace: string) -> list<offset>;
        /// Changes it as `view.apply` does, without a view: for a buffer
        /// that may not be shown, such as a plugin's own. The selections of
        /// the views on it move with the change.
        apply: func(base-version: u64, edits: list<edit>, undo: undo-mode) -> result<_, error>;
        /// Saves it, or with `path`, saves it there and makes that its path.
        save: func(path: option<string>) -> result<_, string>;
        /// Closes it; views that showed it show the buffer before. Without
        /// `force`, fails when it has unsaved changes. Its handles can no
        /// longer be used.
        close: func(force: bool) -> result<_, string>;

        /// For the plugin that made it with `create`: lets editing in views
        /// change it, as `view.apply` and undo do, or back to only its
        /// owner's `apply`. Others' calls do nothing.
        set-editable: func(editable: bool);
        /// For the plugin that made it: the keys that work in it, as
        /// settings write them ("ret", "s", "C-c C-c"), and the commands of
        /// its own they run. The base takes them over its own keys, but for
        /// those it keeps, such as vim's motions (docs/plugin-buffers.md).
        set-keys: func(keys: list<tuple<string, string>>) -> result<_, string>;
        /// For the base: the keys its maker gave it.
        keys: func() -> list<tuple<string, string>>;
    }

    /// Makes an empty buffer of this plugin's, without a path, named
    /// `name`, such as "*diagnostics*", without showing it. Only this plugin
    /// may change it, with `buffer.apply`: editing it in a view fails with
    /// `read-only`, the owner's too, until it says otherwise. It is never
    /// saved, and it closes when this plugin stops.
    create: func(name: string) -> buffer;

    /// Opens a file, or finds the buffer that has it open, without showing
    /// it.
    open: func(path: string) -> result<buffer, string>;
    /// Every open buffer, e.g. for a plugin enabled after files were opened.
    all: func() -> list<buffer>;
}

interface view {
    use types.{offset, range, selection, edit, undo-mode, cursor-shape, error};
    use buffer.{buffer};

    variant scroll-amount {
        lines(s32),
        half-page(s32),
        page(s32),
    }

    enum direction { vertical, horizontal }

    enum toward { next, left, right, up, down }

    /// The focused view.
    resource view {
        buffer: func() -> buffer;
        /// Shows `buf` in it.
        show: func(buf: borrow<buffer>);
        /// Shows the next or the previous open buffer.
        show-next: func();
        show-previous: func();
        selection: func() -> selection;
        set-selection: func(sel: selection) -> result<_, error>;
        /// Applies `edits` atomically. Without `after`, the selection is
        /// mapped through the change.
        apply: func(base-version: u64, edits: list<edit>, after: option<selection>, undo: undo-mode) -> result<_, error>;
        /// Undoes a step and returns where the text changed: the first
        /// change, in the text after it. `none` when there is nothing to
        /// undo.
        undo: func() -> option<range>;
        redo: func() -> option<range>;
        set-cursor-shape: func(shape: cursor-shape);
        /// Moves `lines` display lines down, or up if negative, from `pos`.
        /// Aims for display `column`, or the column of `pos` when none.
        /// Returns the new position and the column aimed for; pass that
        /// column back to keep it across short lines.
        move-vertically: func(pos: offset, lines: s32, column: option<u32>) -> result<tuple<offset, u32>, error>;
        /// Scrolls without moving the cursor, and returns how many lines
        /// `amount` stands for, negative upward. Move the cursor as many
        /// lines to scroll with it, as Ctrl-d does; the core keeps the
        /// cursor in view either way.
        scroll: func(amount: scroll-amount) -> s32;
        /// The part of the buffer on screen: from the start of the first line
        /// shown to the end of the last one.
        visible-range: func() -> range;
    }

    active: func() -> view;
    /// Splits the focused view, side by side or one above the other; the
    /// new view shows the same buffer and takes the focus.
    split: func(direction: direction);
    /// Closes the focused view; fails for the last one.
    close: func() -> result<_, string>;
    /// Closes every view but the focused one.
    only: func();
    focus: func(toward: toward);
}

/// The editor as a whole.
interface editor {
    /// The editor's working directory, as an absolute path. Buffer paths
    /// are as they were opened, so they may be relative to it.
    working-directory: func() -> string;
    /// Quits; without `force`, fails when buffers have unsaved changes.
    quit: func(force: bool) -> result<_, string>;
    /// Opens config.toml, or with `plugin`, `plugins/<plugin>.toml`.
    open-config: func(plugin: option<string>) -> result<_, string>;
    /// Reads the settings again.
    reload-config: func();
    /// Opens the core menu.
    open-menu: func();

    record date-time { year: u32, month: u8, day: u8, hour: u8, minute: u8 }

    /// A time, in seconds since 1970, in the time zone nib runs in, which
    /// a plugin cannot know: UTC on Windows.
    local-time: func(seconds: u64) -> date-time;
}

interface input {
    /// Adds a layer for this plugin on top of the input stack. Keys go to the
    /// top layer first.
    push-layer: func();
    /// Removes this plugin's topmost layer.
    pop-layer: func();

    /// A key a plugin's manifest suggests for one of its commands, under
    /// the base's leader. `keys` is written as settings write keys, such as
    /// "w" or "c d".
    record leader-key { plugin: string, keys: string, command: string }

    /// For the base: the keys enabled plugins suggest, in the order they
    /// were loaded.
    leader-keys: func() -> list<leader-key>;

    /// The base's state: the base, its name for the mode ("normal",
    /// "insert"; "global" for bases without modes), and whether plain chars
    /// go into the text.
    record mode { base: string, name: string, typing: bool }

    /// For the base: says what mode it is in; others get `mode-changed`.
    /// Calls from plugins that are not the running base do nothing.
    set-mode: func(name: string, typing: bool);
    current-mode: func() -> mode;
}

interface commands {
    /// Registers the command `<plugin>.<name>`, where `<plugin>` is this
    /// plugin's name. Calls reach this plugin's `run-command` with `name`.
    /// Registering a name again replaces its description.
    register: func(name: string, description: string);

    /// Runs a command by its full name and waits for its result. Arguments
    /// and the result are JSON; empty arguments are `{}`. Calling a plugin
    /// that is already in a call, such as the caller itself, is an error.
    /// The core's commands, such as `buffer.save`, call the functions of
    /// this API by name, for keys and command lines.
    call: func(name: string, args: string) -> result<string, string>;

    /// Every command, core and registered, with its description.
    all: func() -> list<tuple<string, string>>;
}

/// Other programs, for plugins with the "process" capability. Output is
/// read on background threads and arrives as events, so plugins never wait
/// for it.
interface process {
    enum %stream { stdout, stderr }

    /// A running program. Dropping it kills the program.
    resource child {
        /// The id its events carry.
        id: func() -> u64;
        /// Writes to its standard input. A program that does not read can
        /// make this wait, so write in pieces it answers.
        write: func(data: list<u8>) -> result<_, string>;
        close-stdin: func();
        kill: func();
    }

    /// Starts `command` with `args`, in `cwd` or the editor's working
    /// directory.
    spawn: func(command: string, args: list<string>, cwd: option<string>) -> result<child, string>;
}

/// The system clipboard, for plugins with the "clipboard" capability.
interface clipboard {
    get: func() -> result<string, string>;
    set: func(text: string) -> result<_, string>;
}

/// File lists, for plugins with the "fs-read" capability. The files are
/// counted on a background thread, so plugins never wait for them.
interface files {
    record dir-entry {
        name: string,
        /// A directory, or a link to one.
        directory: bool,
        /// In bytes; 0 for a directory.
        size: u64,
        /// The Unix permission bits, such as 0o755; none elsewhere.
        mode: option<u32>,
        /// When it last changed, in seconds since 1970.
        modified: option<u64>,
    }

    record walk-options {
        /// Hidden files and directories too.
        hidden: bool,
        /// What .gitignore and the like leave out too.
        ignored: bool,
    }

    /// What `dir` holds, hidden files too, sorted by name: one level, not
    /// the files under it. Needs the "fs-read" capability.
    %list: func(dir: string) -> result<list<dir-entry>, string>;
    /// Lists the files under `dir`, or the working directory, honoring
    /// .gitignore and leaving out hidden files. The paths arrive as
    /// `files-listed` events, relative to `dir` and with `/` between names.
    /// Returns the job's id.
    walk: func(dir: option<string>) -> result<u64, string>;
    /// As `walk`, with hidden files and ignored ones when asked.
    walk-with: func(dir: option<string>, options: walk-options) -> result<u64, string>;
    /// Makes a directory, and those above it that are missing. Needs the
    /// "fs-write" capability.
    make-dir: func(path: string) -> result<_, string>;
    /// Stops a job; nothing more arrives from it.
    cancel: func(id: u64);
}

/// Events reach `guest.on-event` after the call that caused them, in the
/// order they happened. A plugin gets the kinds listed in `events` in its
/// plugin.toml, and its own timers and programs.
interface events {
    use types.{offset};
    use buffer.{buffer};
    use input.{mode};
    use process.{%stream};
    use prompt.{action};

    /// One change, at positions in the text as it is when the changes
    /// before it in the list have been applied. Lines and columns count
    /// from 0; columns are in bytes.
    record text-change {
        start: offset,
        end: offset,
        start-line: u32,
        start-column: u32,
        end-line: u32,
        end-column: u32,
        text: string,
    }

    /// Applying `changes` in order turns the text before into the text at
    /// `version`, as LSP's `didChange` does.
    record buffer-change {
        buffer: buffer,
        version: u64,
        changes: list<text-change>,
    }

    /// A buffer that was closed: its path, if it had one, and its name.
    record closed-buffer { path: option<string>, name: string }

    /// The buffer's syntax tree is up to date with `version` after the
    /// parse that follows an edit.
    record syntax-update { buffer: buffer, version: u64 }

    /// An event a plugin emitted; `name` has the plugin's name in front.
    record custom-event { name: string, data: string }

    /// Output as it was read, not split into lines.
    record process-output { process: u64, %stream: %stream, data: list<u8> }

    /// `code` is missing when the program had none, e.g. when a signal
    /// ended it.
    record process-exit { process: u64, code: option<s32> }

    /// Up to a thousand paths of a `files.walk` job; the last ones have
    /// `done`.
    record files-listed { job: u64, paths: list<string>, done: bool }

    /// A prompt's text after the base edited it; `cursor` is a byte offset
    /// into `text`.
    record prompt-change { id: u64, text: string, cursor: u32 }

    /// What a key asked of a prompt, besides editing it.
    record prompt-act { id: u64, action: action }

    variant event {
        buffer-opened(buffer),
        buffer-saved(buffer),
        buffer-changed(buffer-change),
        /// A buffer was closed; its handles no longer work.
        buffer-closed(closed-buffer),
        syntax-updated(syntax-update),
        /// The base said what mode it is in (`input.set-mode`).
        mode-changed(mode),
        custom(custom-event),
        /// The id `timers.set` returned.
        timer(u64),
        /// Only to the plugin that started the program.
        process-output(process-output),
        process-exit(process-exit),
        /// Only to the plugin that asked for the list.
        files-listed(files-listed),
        /// Only to the plugin that opened the prompt.
        prompt-changed(prompt-change),
        prompt-action(prompt-act),
    }

    /// Emits the custom event `<plugin>.<name>` with JSON `data`.
    emit: func(name: string, data: string);
}

interface timers {
    /// Sends `timer(id)` once, `ms` milliseconds from now, and returns `id`.
    /// Timers are checked between keys, never during a call.
    set: func(ms: u32) -> u64;
    cancel: func(id: u64);
}

interface ui {
    use types.{offset, styled-line};
    use buffer.{buffer};

    enum side { left, right }

    /// Shows an item in the status line, replacing this plugin's item with
    /// the same `id`. Items on one side are ordered by `priority`, lowest
    /// first.
    set-status: func(id: string, side: side, priority: s32, content: styled-line);
    remove-status: func(id: string);

    /// Shows a message until the next key.
    show-message: func(text: string);

    /// Lines at the bottom of the screen, above the status line. Dropping the
    /// panel closes it.
    resource panel {
        constructor(lines: list<styled-line>);
        update: func(lines: list<styled-line>);
        /// A line index and a byte offset into that line's text. While set,
        /// the cursor is drawn there instead of in the buffer.
        set-cursor: func(cursor: option<tuple<u32, u32>>);
    }

    variant popup-anchor {
        /// Below the line of this offset in the shown buffer, or above it
        /// when there is no room. Hidden while the offset is off screen.
        /// The offset does not follow edits: open a new popup to move it.
        position(offset),
        /// The bottom-right corner of the text, e.g. for key hints.
        corner,
    }

    /// Lines drawn over the text. They never take the cursor. Dropping the
    /// popup closes it.
    resource popup {
        constructor(anchor: popup-anchor, lines: list<styled-line>);
        update: func(lines: list<styled-line>);
    }

    /// A style over `start..end` of a buffer, drawn over the syntax
    /// highlighting and under the selection. It only sets what the style
    /// sets, e.g. the text color.
    record decoration { start: offset, end: offset, style: string }

    /// Replaces this plugin's decorations in `namespace` on `buf`; an empty
    /// list removes them. The core moves them with later edits, and drops
    /// ones whose text is deleted. Ranges are cut to the buffer.
    set-decorations: func(buf: borrow<buffer>, namespace: string, decorations: list<decoration>);

    /// Text shown after the end of the line of `at`, such as a diagnostic's
    /// message.
    record note { at: offset, text: string, style: string }

    /// Replaces this plugin's notes in `namespace` on `buf`, as with
    /// decorations. Notes move with edits and stay when the text around
    /// them is deleted.
    set-notes: func(buf: borrow<buffer>, namespace: string, notes: list<note>);
}

/// A line of text being typed, such as a command line or a picker's query.
/// The plugin that opens one owns it and hears what happens to it through
/// events; the base in use decides what each key does to it.
interface prompt {
    use types.{styled-line};

    /// What a key can ask of a prompt's owner, besides editing the text.
    enum action {
        /// Take the text, as Enter does.
        accept,
        /// Give up, as Escape does.
        cancel,
        /// The next candidate, as Down does.
        next,
        previous,
        /// A screen of candidates further, as PageDown does.
        page-next,
        page-previous,
        /// Complete what is typed, as Tab does.
        complete,
        /// Back to the completion before, as Shift-Tab does.
        complete-back,
    }

    /// Drawn above the status line, with `label` in front. While it is the
    /// newest one open, keys go to the base in use instead of the input
    /// stack. Dropping it closes it.
    resource line {
        constructor(label: string);
        /// The id its events carry.
        id: func() -> u64;
        text: func() -> string;
        /// A byte offset into the text.
        cursor: func() -> u32;
        /// Replaces the text, as when completing; no event follows. The
        /// cursor is moved back to a char boundary and into the text.
        set: func(text: string, cursor: u32);
        set-label: func(label: string);
        /// Shown at the right end, such as "3/10".
        set-hint: func(hint: string);
        /// Shows it as the input of a box in the middle of the screen, as
        /// the core menu, titled `title`, with the rows of `set-rows` under
        /// it and `set-preview` beside them (docs/finder.md). Without it,
        /// it is drawn above the status line.
        show-in-box: func(title: string);
        /// The rows under the input in the box, and the one selected. A
        /// window of rows around the selected one is enough: the box shows
        /// as many as fit, with the selected one among them.
        set-rows: func(rows: list<styled-line>, selected: option<u32>);
        /// What the box shows beside the rows.
        set-preview: func(preview: preview);
    }

    variant preview {
        none,
        /// Lines of text, such as a command's description.
        lines(list<styled-line>),
        /// The start of a file, colored as its language; or, with `line`,
        /// the lines around that one, which is marked. The core reads the
        /// file, and the plugin never sees it.
        file(file-preview),
    }

    record file-preview { path: string, line: option<u64> }

    /// A list shown without a line to type into, such as completions, which
    /// its owner draws. While it is the newest one open and no prompt is,
    /// the base turns its own keys for `actions` into `prompt-action`
    /// events for it. A key that does not act on it is handled as usual,
    /// and sends `cancel` before the events it causes, as the list no
    /// longer fits. Dropping it closes it.
    resource choices {
        constructor(actions: list<action>);
        /// The id its events carry.
        id: func() -> u64;
    }

    /// The prompt keys go to; `mine` if the caller opened it.
    record state { id: u64, label: string, text: string, cursor: u32, mine: bool }

    /// Choices keys may act on: their id, and the actions they take.
    record offer { id: u64, actions: list<action> }

    /// For the base: the prompt keys go to, if one is open.
    active: func() -> option<state>;
    /// For the base: replaces the active prompt's text; its owner gets
    /// `prompt-changed`.
    edit: func(text: string, cursor: u32);
    /// For the base: the newest choices, while no prompt is open.
    offered: func() -> option<offer>;
    /// For the base: sends `action` as `prompt-action` to the owner of the
    /// active prompt, or else of the offered choices.
    act: func(action: action);
}

interface settings {
    use buffer.{buffer};

    /// How a level of indentation is made.
    variant indentation { spaces(u8), tab }

    /// The editing settings of `buf`: config.toml's, or what a plugin set
    /// for it alone.
    tab-width: func(buf: borrow<buffer>) -> u8;
    indent: func(buf: borrow<buffer>) -> indentation;
    /// Lines kept between the cursor and the edge of the view.
    scroll-margin: func() -> u32;
    /// Sets the tab width for `buf` alone (1 to 16), over config.toml's;
    /// `none` goes back to it. The last plugin to set a value wins, and what
    /// a plugin set goes away when it stops.
    set-tab-width: func(buf: borrow<buffer>, width: option<u8>) -> result<_, string>;
    set-indent: func(buf: borrow<buffer>, indent: option<indentation>) -> result<_, string>;
}

/// The syntax trees the core keeps for buffers with a language. Every
/// function brings the buffer's tree up to date first, so it reflects edits
/// made earlier in the same call. Buffers without a tree give `none` or an
/// empty list.
interface syntax {
    use types.{offset, range};
    use buffer.{buffer};

    /// A node of a buffer's syntax tree, as it was when returned. Nodes are
    /// values: `parent` and `children` find them again by `id` and range,
    /// and after the buffer changes they may no longer find them.
    record node {
        /// Tells apart nodes with the same range, e.g. an expression
        /// statement and the call it consists of.
        id: u64,
        /// The grammar's name for it, e.g. "function_item" or "(".
        kind: string,
        /// False for punctuation and keywords, which grammars name by their
        /// text.
        named: bool,
        start: offset,
        end: offset,
    }

    /// The name of the buffer's language.
    language: func(buf: borrow<buffer>) -> option<string>;
    /// The smallest node covering `start..end`, or with `named`, the
    /// smallest named one.
    node-at: func(buf: borrow<buffer>, start: offset, end: offset, named: bool) -> option<node>;
    parent: func(buf: borrow<buffer>, of: node) -> option<node>;
    /// All children in order, named or not.
    children: func(buf: borrow<buffer>, of: node) -> list<node>;
    /// Runs the language's query named `query`, e.g. "textobjects", over
    /// `start..end`, and returns where `capture` matched, in order. When one
    /// match captures several nodes under that name, as with
    /// `(line_comment)+ @comment.around`, they make one range from the first
    /// to the last. Each range appears once. Empty when the language has no
    /// such query.
    captures: func(buf: borrow<buffer>, query: string, capture: string, start: offset, end: offset) -> list<range>;
}

interface guest {
    use types.{key-event};
    use events.{event};

    enum key-result {
        handled,
        /// Let the layer below handle the key.
        pass,
    }

    /// Called once after loading. `config` is the plugin's config table as JSON.
    init: func(config: string) -> result<_, string>;

    /// A key reached one of this plugin's input layers. The core's menu key
    /// (Ctrl-g by default) never arrives.
    handle-key: func(ev: key-event) -> key-result;

    /// Text pasted into the terminal reached one of this plugin's input
    /// layers, as one piece. When every layer passes, the core puts it into
    /// the open prompt, or before each selection of the shown buffer.
    handle-paste: func(text: string) -> key-result;

    /// One of this plugin's registered commands was called, by the name it
    /// was registered with.
    run-command: func(name: string, args: string) -> result<string, string>;

    on-event: func(ev: event);
}

world plugin {
    import buffer;
    import view;
    import editor;
    import input;
    import commands;
